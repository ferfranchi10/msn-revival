# Copiar a .env.local y completar con los valores reales del proyecto Firebase.
# Nunca commitear .env.local ni pegar valores reales en este archivo.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK (server-only, para generar el link de verificación de email).
# Se obtiene en la consola de Firebase: Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada (descarga un JSON con estos tres campos).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Envío del email de bienvenida/verificación por el relay SMTP de Gmail (gratis,
# sin necesidad de un dominio propio verificado, hasta ~500 emails/día).
# GMAIL_USER: la cuenta de Gmail remitente (necesita verificación en 2 pasos activada).
# GMAIL_APP_PASSWORD: contraseña de aplicación de 16 caracteres — se genera en
# Google Account > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones
# (NO es la contraseña normal de la cuenta).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Web Push (FASE 8). Generar el par de claves UNA vez con:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY: clave pública (viaja al navegador, no es secreta).
# VAPID_PRIVATE_KEY: clave privada (secreta, solo servidor; en Vercel marcarla "Sensitive").
# VAPID_SUBJECT: contacto del servidor de push, formato mailto:tu-correo@ejemplo.com
# Sin estas tres variables el push queda desactivado y el resto de la app funciona igual.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
