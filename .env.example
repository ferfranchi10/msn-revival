# Copiar a .env.local y completar con los valores reales del proyecto Firebase.
# Nunca commitear .env.local ni pegar valores reales en este archivo.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK (server-only, para generar el link de verificación de email).
# Se obtiene en la consola de Firebase: Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada (descarga un JSON con estos tres campos).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (envío del email de bienvenida/verificación). API key en resend.com/api-keys.
RESEND_API_KEY=
# Remitente verificado en Resend. Con un dominio propio verificado usar algo como
# "MSN Revival <hola@tu-dominio.com>"; para probar sin dominio propio se puede usar
# el remitente de prueba de Resend, "MSN Revival <onboarding@resend.dev>" (solo
# entrega a la casilla dueña de la cuenta de Resend, no sirve para producción real).
EMAIL_FROM=
